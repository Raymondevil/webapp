{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "webapp",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"d1_databases": [
		{
			"binding": "serve",
			"database_name": "serve",
			"database_id": "4b485846-2317-417a-a00c-eda1ae06dde4"
		}
	]
}